---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { section: 'historias' }, props: { title: 'Historias', intro: 'Notas personales, viajes, observaciones y las historias que valen la pena contar.' } },
    { params: { section: 'lugares' }, props: { title: 'Lugares', intro: 'Guías vividas: lo que hicimos, lo que saltaría y lo que haría distinto.' } },
    { params: { section: 'en-proceso' }, props: { title: 'En proceso', intro: 'Proyectos, carreras, preguntas y habilidades en construcción.' } },
    { params: { section: 'sobre-mi' }, props: { title: 'Sobre mí', intro: 'Soy Zaira. Engineer by profession, curious about almost everything else.' } },
  ];
}

const { title, intro } = Astro.props;
---

<BaseLayout title={`${title} — Entre Vías`}>
  <Nav />
  <section class="section page-intro">
    <p class="eyebrow">ENTRE VÍAS</p>
    <h1>{title}</h1>
    {title === 'Sobre mí' ? (
      <>
        <p class="about-tagline">{intro}</p>
        <div class="about-copy">
          <p>Hi, I’m Zaira. I’m curious by nature, and someone who is always trying to pay closer attention to the life she’s living.</p>
          <p>Entre Vías is a place to keep stories, places, photographs, half-formed ideas, and the small things I want to remember. There’s room here for travel, long runs, underlined books, conversations, questions, and the paths that appear before you fully know where you’re going.</p>
          <p>I don’t think I ever have all the answers. I hope to just make more space to look with intention, share what I’m learning, and keep living a life <em>en movimiento</em>.</p>
        </div>
        <a class="work-link" href="/work">
          <span>FOR WORK</span>
          <strong>Zaira Espinoza — Engineer · AI/ML · Systems</strong>
          <b>→</b>
        </a>
      </>
    ) : (
      <>
        <p>{intro}</p>
        <div class="placeholder-note">Próximamente.</div>
      </>
    )}
  </section>
  <Footer />
</BaseLayout>
