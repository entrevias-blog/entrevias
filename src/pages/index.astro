---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const miradasPreview = [
  'IMG_1690.JPG',
  'IMG_1691.JPG',
  'IMG_1694.JPG',
  'IMG_1696.JPG',
];

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
const cardColors = ['yellow', 'green', 'terracotta'];
---

<BaseLayout>
  <Nav />
  <section class="hero">
    <p class="eyebrow">UNA VIDA EN MOVIMIENTO</p>
    <h1>ENTRE<br />VÍAS</h1>
    <div class="vias" aria-hidden="true"><i></i><i></i></div>
    <p class="hero-intro">Historias, lugares, miradas y cosas que todavía estoy aprendiendo.</p>
    <a class="text-link" href="#reciente">Explorar lo reciente <span>↓</span></a>
  </section>

  <section class="feature section" id="reciente">
    {featuredPost?.data.cover && <img class="feature-image" src={featuredPost.data.cover.src} alt="" />}
    {!featuredPost?.data.cover && <div class="feature-image" aria-hidden="true"></div>}
    <div class="feature-copy">
      {featuredPost ? (
        <>
          <p class="eyebrow">{featuredPost.data.section} · {featuredPost.data.date.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' })}</p>
          <h2>{featuredPost.data.title}</h2>
          <p>{featuredPost.data.excerpt}</p>
          <a class="text-link" href={`/${featuredPost.data.section}/${featuredPost.id}`}>Leer historia <span>→</span></a>
        </>
      ) : (
        <>
          <p class="eyebrow">HISTORIAS · PRÓXIMAMENTE</p>
          <h2>La primera historia está por llegar.</h2>
          <p>Este rincón se va llenando poco a poco: con lugares, miradas y cosas que vale la pena recordar.</p>
          <a class="text-link" href="/historias">Explorar historias <span>→</span></a>
        </>
      )}
    </div>
  </section>

  <section class="section lately">
    <p class="eyebrow">ÚLTIMAMENTE</p>
    {latestPosts.length ? (
      <div class="story-grid">
        {latestPosts.map((post, index) => (
          <a class={`story-card ${cardColors[index]}`} href={`/${post.data.section}/${post.id}`}>
            <span>{post.data.section}</span><h3>{post.data.title}</h3><em>{post.data.excerpt}</em>
          </a>
        ))}
      </div>
    ) : <p class="empty-feed">Tus próximas publicaciones aparecerán aquí.</p>}
  </section>

  <section class="miradas section">
    <div class="section-heading"><p class="eyebrow">MIRADAS</p><a class="text-link" href="/miradas">Ver archivo <span>→</span></a></div>
    <div class="miradas-preview">
      {miradasPreview.map((image, index) => <img src={`/images/web/${image}`} alt={`Photograph from the Miradas archive, ${index + 1}`} loading="lazy" />)}
    </div>
  </section>

  <section class="now section">
    <p class="eyebrow">AHORA MISMO</p>
    <dl>
      <div><dt>leyendo</dt><dd><em>Archer's Voice</em></dd></div>
      <div class="listening-row"><dt>escuchando</dt><dd id="spotify-listening">una playlist para correr despacio</dd></div>
      <div><dt>aprendiendo</dt><dd>cómo hacer de esta página un hogar</dd></div>
      <div><dt>pensando en</dt><dd>todas las cosas que caben entre dos destinos</dd></div>
    </dl>
  </section>

  <section class="about section">
    <p class="eyebrow">HOLA, SOY ZAIRA</p>
    <h2>Engineer by profession, curious about almost everything else.</h2>
    <a class="text-link" href="/sobre-mi">Más sobre mí <span>→</span></a>
  </section>
  <Footer />
  <script>
    const listening = document.querySelector('#spotify-listening');

    fetch('/api/listening')
      .then((response) => response.ok ? response.json() : Promise.reject())
      .then(({ track }) => {
        if (!track || !listening) return;
        const link = document.createElement('a');
        link.href = track.url;
        link.target = '_blank';
        link.rel = 'noreferrer';
        link.textContent = `${track.name} — ${track.artist}`;
        listening.replaceChildren(link);
      })
      .catch(() => {});
  </script>
</BaseLayout>
