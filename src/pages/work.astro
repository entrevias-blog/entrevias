---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Zaira Espinoza — Work" description="Professional work by Zaira Espinoza.">
  <Nav />
  <section class="section work-intro">
    <div class="work-intro-copy">
      <p class="eyebrow">FOR WORK</p>
      <h1>Zaira<br />Espinoza</h1>
      <p class="work-role">Engineer <span>·</span> AI/ML <span>·</span> Systems <span>·</span> Integration &amp; Test</p>
      <p class="work-summary">I build and test systems, follow questions until they become useful, and care about making complex things work clearly.</p>
      <div class="work-actions">
        <a class="text-link" href="mailto:holaentrevias@gmail.com">Get in touch <span>→</span></a>
        <a class="text-link" href="/documents/Zaira_Espinoza_Resume.pdf" download>Download résumé <span>↓</span></a>
        <a class="text-link" href="#projects">Selected work <span>↓</span></a>
      </div>
    </div>
    <figure class="ai-lifecycle" aria-label="Seven phases of an AI-enabled software lifecycle">
      <span class="lifecycle-ring" aria-hidden="true"></span>
      <div class="lifecycle-core"><span>AI-enabled</span>software<br />lifecycle</div>
      <div class="lifecycle-orbit">
        <div class="lifecycle-orbit-item" style="--angle:-90deg"><div class="lifecycle-phase tone-pistachio"><b>01</b><span>Define<br />the problem</span></div></div>
        <div class="lifecycle-orbit-item" style="--angle:-38.571deg"><div class="lifecycle-phase tone-cream"><b>02</b><span>Gather<br />context</span></div></div>
        <div class="lifecycle-orbit-item" style="--angle:12.857deg"><div class="lifecycle-phase tone-terra"><b>03</b><span>Prepare<br />data</span></div></div>
        <div class="lifecycle-orbit-item" style="--angle:64.286deg"><div class="lifecycle-phase tone-butter"><b>04</b><span>Design<br />architecture</span></div></div>
        <div class="lifecycle-orbit-item" style="--angle:115.714deg"><div class="lifecycle-phase tone-terra"><b>05</b><span>Build +<br />evaluate</span></div></div>
        <div class="lifecycle-orbit-item" style="--angle:167.143deg"><div class="lifecycle-phase tone-cream"><b>06</b><span>Integrate +<br />deploy</span></div></div>
        <div class="lifecycle-orbit-item" style="--angle:218.571deg"><div class="lifecycle-phase tone-pistachio"><b>07</b><span>Monitor +<br />improve</span></div></div>
      </div>
    </figure>
  </section>

  <section class="section work-projects" id="projects">
    <p class="eyebrow">SELECTED EXPERIENCE</p>
    <div class="experience-list">
      <article class="experience-item">
        <div>
          <p class="experience-meta">LOCKHEED MARTIN · JAN 2024–PRESENT</p>
          <h2>Engineering Leadership Development Program</h2>
          <p class="experience-role">Senior Engineer</p>
        </div>
        <p>Working across systems engineering, integration and test, and enterprise AI.</p>
      </article>
      <article class="experience-item">
        <div>
          <p class="experience-meta">LOCKHEED MARTIN · ENTERPRISE OPERATIONS</p>
          <h2>AI Solutions Engineer</h2>
        </div>
        <p>Designing and delivering production AI applications, from stakeholder discovery to deployment and user adoption.</p>
      </article>
      <article class="experience-item">
        <div>
          <p class="experience-meta">LOCKHEED MARTIN · AERONAUTICS</p>
          <h2>Integration &amp; Test Engineer</h2>
        </div>
        <p>Supporting integration, verification, qualification testing, and anomaly resolution for aerospace systems.</p>
      </article>
      <article class="experience-item">
        <div>
          <p class="experience-meta">LOCKHEED MARTIN AERONAUTICS · MAR 2022–DEC 2023</p>
          <h2>Data Analyst</h2>
        </div>
        <p>Worked on aircraft delivery data, component tracking, data validation, and process improvement.</p>
      </article>
    </div>
    <a class="text-link resume-link" href="/documents/Zaira_Espinoza_Resume.pdf" download>Download full résumé <span>↓</span></a>
  </section>
  <Footer />
</BaseLayout>
