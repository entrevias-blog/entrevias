---
const links = [
  ['Historias', '/historias'],
  ['Lugares', '/lugares'],
  ['Miradas', '/miradas'],
  ['En proceso', '/en-proceso'],
  ['Sobre mí', '/sobre-mi'],
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Entre Vías, inicio">ENTRE VÍAS</a>
  <nav aria-label="Navegación principal">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
</header>
